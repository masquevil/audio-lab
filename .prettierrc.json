{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": true,
  "tabWidth": 2,
  "singleQuote": true,
  "singleAttributePerLine": true,
  "printWidth": 100,
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "printWidth": 1,
        "proseWrap": "never",
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
